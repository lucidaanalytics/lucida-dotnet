<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Lucida</PackageId>
    <Version>0.1.0</Version>
    <Description>Lucida server SDK: capture, identify, local feature-flag evaluation and offline test mode</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lucidaanalytics/lucida-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://github.com/lucidaanalytics/lucida-dotnet</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lucida.Tests" />
  </ItemGroup>
</Project>
