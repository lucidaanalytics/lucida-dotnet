<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Lucida.OpenFeature</PackageId>
    <Version>0.1.0</Version>
    <Description>OpenFeature server provider over the Lucida .NET SDK</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lucidaanalytics/lucida-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://github.com/lucidaanalytics/lucida-dotnet</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenFeature" Version="2.14.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lucida.OpenFeature.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Lucida/Lucida.csproj" />
  </ItemGroup>
</Project>
